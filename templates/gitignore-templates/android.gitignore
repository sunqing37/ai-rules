# Android 项目 .gitignore — 复制到项目根目录并重命名为 .gitignore

# Built application files
*.apk
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java/Kotlin class files
*.class

# Generated files
bin/
gen/
out/
build/

# Gradle files
.gradle/
.gradletasknamecache

# Local configuration
local.properties

# IDE
.idea/
*.iml
*.iws
*.ipr
.navigation/

# Android Studio
captures/
.externalNativeBuild/
.cxx/

# OS
.DS_Store
Thumbs.db

# Kotlin
*.kotlin_module

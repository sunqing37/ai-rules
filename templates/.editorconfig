# EditorConfig — 复制到项目根目录并重命名为 .editorconfig
# 详见 .ai-rules/rules/line-endings.md

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml}]
indent_size = 2

[*.{kt,kts}]
indent_size = 4
ij_kotlin_code_style_defaults = KOTLIN_OFFICIAL

[*.{ts,tsx,js,jsx,json}]
indent_size = 2

[*.{xml,html}]
indent_size = 2

[Makefile]
indent_style = tab

# Windows 脚本文件需要 CRLF
[*.{bat,cmd,ps1}]
end_of_line = crlf
